{
  "name": "sahati-wa-sukari",
  "version": "1.0.0",
  "private": true,
  "description": "صحتي وسكري — منصة متابعة مرضى السكري (MVP)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test:security": "NODE_ENV=test DATABASE_URL=\"${SECURITY_TEST_DATABASE_URL:-postgresql://test:test@127.0.0.1:1/test}\" SESSION_SECRET=security-test-session-secret-with-32-bytes FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= NATIONAL_ID_PEPPER=security-test-national-id-pepper-with-32-bytes APP_URL=https://example.test tsx --test tests/security/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:activation-preview": "tsx scripts/preview-account-activation.ts",
    "db:setup": "bash scripts/setup-postgres.sh && tsx scripts/migrate.ts && tsx scripts/create-admin.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:clear-patients": "tsx scripts/clear-patient-data.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "puppeteer": "^25.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "resend": "^6.34.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
