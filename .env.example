# ---------------------------------------------------------------------------
# صحتي وسكري — نموذج متغيرات البيئة (انسخه إلى .env.local ثم عدّل القيم)
# ---------------------------------------------------------------------------

# اتصال قاعدة بيانات PostgreSQL
DATABASE_URL=postgres://sahati:CHANGE_ME@127.0.0.1:5432/sahati

# سر توقيع/تجزئة الجلسات (48 بايت عشوائية base64url)
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_48_BYTE_SECRET

# مفتاح تشفير الحقول الحساسة (32 بايت base64) — لا تغيّره بعد إدخال بيانات
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# سر إضافي لبناء فهرس البحث عن الرقم الوطني (HMAC)
NATIONAL_ID_PEPPER=CHANGE_ME_RANDOM_STRING

# عنوان التطبيق (يُستخدم في الروابط وملفات PDF)
APP_URL=http://localhost:3000

# المنطقة الزمنية الافتراضية للعرض
DISPLAY_TIMEZONE=Asia/Baghdad

# بيانات المدير الأول — تُقرأ مرة واحدة عند الإنشاء
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# بيئة التشغيل
NODE_ENV=development
